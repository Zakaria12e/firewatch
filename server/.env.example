# Ports
HTTP_PORT=3000
COAP_PORT=5683

# Base de données (sans MongoDB, le serveur passe en stockage mémoire)
MONGO_URI=mongodb://127.0.0.1:27017/firewatch

# Alertes iPhone
NTFY_TOPIC=firewatch-zaki-2026
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Simulation
TIME_SCALE=15        # 1 s réelle = 15 s simulées (×vitesse simulateur)
PERIOD_NORMAL=10     # secondes entre deux envois (capteurs)
PERIOD_ALERT=2       # secondes en cas de danger

# Météo Open-Meteo (optionnel)
WEATHER_MODE=manuel  # manuel | reel | prevision

# NASA FIRMS (optionnel, pour corroboration satellite)
FIRMS_MAP_KEY=
